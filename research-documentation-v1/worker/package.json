{
  "name": "ai-dnd-worker",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate": "wrangler d1 migrations apply ai-dnd-db",
    "db:seed": "wrangler d1 execute ai-dnd-db --file=src/db/seed.sql",
    "db:migrate:local": "wrangler d1 migrations apply ai-dnd-db --local",
    "db:seed:local": "wrangler d1 execute ai-dnd-db --local --file=src/db/seed.sql",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "hono": "^4.5.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240924.0",
    "typescript": "^5.5.4",
    "wrangler": "^3.78.0"
  }
}
